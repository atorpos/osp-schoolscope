APP_PORT=3008

# Reviewer accounts that can log in: a JSON array, in single quotes. Use long, unique passwords and share them
# privately. Accounts can also be added later with the accounts CLI (see README).
# DEMO_ACCOUNTS='[{"email":"reviewer@example.com","password":"choose-a-long-password","name":"App Reviewer"}]'
DEMO_ACCOUNTS=

# Optional: signs access tokens, so they stay valid across API restarts. At least 32 characters,
# e.g. the output of: openssl rand -base64 48
AUTH_SECRET=

# auto marks the login cookie Secure for HTTPS requests. Set true when HTTPS ends at a proxy in front of Nginx.
COOKIE_SECURE=auto

# Apple Maps (MapKit JS), from developer.apple.com → Certificates, Identifiers & Profiles → Keys.
# Without them, the school map is drawn without Apple Maps.
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
# The .p8 file's contents on one line in double quotes, with each line break written as \n
MAPKIT_PRIVATE_KEY=
# The address people open, e.g. https://schoolscope.example.com, so a copied map token only works there
MAPKIT_ORIGIN=
