SQLITE_PATH=./data/schoolscope.sqlite
PORT=4000
NODE_ENV=development

# `npm run dev` and `npm run accounts` read backend/.env. Copy this file there to use it.

# Without DEMO_ACCOUNTS, development creates reviewer@schoolscope.test / schoolscope-review
# DEMO_ACCOUNTS=[{"email":"reviewer@example.com","password":"choose-a-long-password","name":"App Reviewer"}]

# Apple Maps (MapKit JS)
# MAPKIT_TEAM_ID=
# MAPKIT_KEY_ID=
# MAPKIT_PRIVATE_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
# MAPKIT_ORIGIN=http://localhost:5173
